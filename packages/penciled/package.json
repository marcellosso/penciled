{
  "name": "penciled",
  "version": "0.5.1",
  "description": "penciled.org, JavaScript highlights & notes library: 15 kB, open source, persistent text highlights and notes on any web page, painted with the CSS Custom Highlight API.",
  "license": "MIT",
  "author": "Marcel Losso",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcellosso/penciled.git",
    "directory": "packages/penciled"
  },
  "homepage": "https://www.penciled.org",
  "bugs": "https://github.com/marcellosso/penciled/issues",
  "keywords": [
    "penciled",
    "penciled.js",
    "penciled.org",
    "annotation",
    "annotations",
    "highlight",
    "text",
    "notes",
    "comments",
    "selection",
    "highlight-api",
    "css-custom-highlight-api",
    "highlighter",
    "text-highlight",
    "web-annotation",
    "react"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "default": "./dist/headless.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "playground": "vite playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "size": "size-limit",
    "test:e2e": "playwright test",
    "bench": "node bench/pages.ts"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "penciled",
      "path": "dist/index.js",
      "import": "*",
      "limit": "16 kB",
      "gzip": true
    },
    {
      "name": "penciled/headless",
      "path": "dist/headless.js",
      "import": "*",
      "limit": "6.5 kB",
      "gzip": true
    },
    {
      "name": "penciled/styles.css",
      "path": "dist/styles.css",
      "limit": "3 kB",
      "rolldown": false,
      "gzip": true
    }
  ],
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.2.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  }
}
