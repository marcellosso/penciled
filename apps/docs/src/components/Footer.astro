---
// Starlight's footer, followed by a quiet line of site links on every docs page.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default />
<footer class="site-links">
  <a href="/compare/">Compare libraries</a>
  <a href="/alternatives/">Highlighter extension alternatives</a>
  <a href="/faq/">FAQ</a>
  <span>Not affiliated with penciled.com.</span>
</footer>

<style>
  .site-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    margin-top: 2rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .site-links a {
    color: inherit;
    text-decoration: none;
  }
  .site-links a:hover {
    color: var(--sl-color-white);
  }
</style>
