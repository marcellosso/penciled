---
// Starlight's head with descriptive titles and structured data, plus PostHog analytics.
import Default from '@astrojs/starlight/components/Head.astro';
import { alternativesFaq } from '../alternatives.ts';
import { disambiguation, type Faq, faq } from '../faq.ts';

const route = Astro.locals.starlightRoute;
const { data } = route.entry;

if (data.metaTitle) {
  for (const tag of route.head) {
    if (tag.tag === 'title') tag.content = `${data.metaTitle} | penciled`;
    else if (tag.attrs?.property === 'og:title' || tag.attrs?.name === 'twitter:title') {
      tag.attrs.content = data.metaTitle;
    }
  }
}

// The 404 page is served at every missing URL, so it must not be indexed. Its canonical still
// names the www host, so no tag on the site ever points at the apex domain.
const notFound = route.id === '404';
const site = Astro.site && new URL('/', Astro.site);
if (notFound) {
  route.head = route.head.filter(
    (tag) => tag.attrs?.rel !== 'canonical' && tag.attrs?.property !== 'og:url',
  );
  route.head.push({ tag: 'meta', attrs: { name: 'robots', content: 'noindex' } });
  if (site) {
    route.head.push({ tag: 'link', attrs: { rel: 'canonical', href: new URL('/404', site).href } });
  }
}

// Pages whose questions are also published as FAQPage structured data.
const faqPages: Record<string, Faq[]> = { faq, alternatives: alternativesFaq };
const faqs = faqPages[route.id];

const url = !notFound && site && new URL(Astro.url.pathname, site).href;
const home = site?.href;
const project = {
  '@type': 'SoftwareApplication',
  name: 'penciled',
  alternateName: ['penciled.org', 'penciled.js', 'penciled JavaScript library'],
  disambiguatingDescription: disambiguation,
  url: home,
};
const structuredData = url &&
  home && [
    {
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: data.metaTitle ?? data.title,
      description: data.description,
      url,
      inLanguage: 'en',
      ...(route.lastUpdated && { dateModified: route.lastUpdated.toISOString() }),
      author: { '@type': 'Person', name: 'Marcel Losso', url: 'https://github.com/marcellosso' },
      about: project,
      isPartOf: { '@type': 'WebSite', name: 'penciled.org', url: home },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'penciled.org', item: home },
        { '@type': 'ListItem', position: 2, name: data.title, item: url },
      ],
    },
    ...(faqs
      ? [
          {
            '@context': 'https://schema.org',
            '@type': 'FAQPage',
            url,
            about: project,
            mainEntity: faqs.map(({ question, answer }) => ({
              '@type': 'Question',
              name: question,
              acceptedAnswer: { '@type': 'Answer', text: answer },
            })),
          },
        ]
      : []),
  ];
---

<Default />
{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
<script>
  import '../scripts/analytics.ts';
</script>
